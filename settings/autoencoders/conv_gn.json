{
  "model": {
    "arch": "conv_gn",
    "model_type": "vae",
    "in_channels": 1,
    "img_h": 256,
    "img_w": 256,
    "preprocessing_version": "ae-pil-v1",
    "vae_use_mean": true,
    "keep_aspect": true,
    "pad_value": 0,
    "latent_dim": 512,
    "model_in_channels": 1,
    "out_channels": 1,
    "use_edge_channel": false,
    "norm_type": "gn",
    "base": 32,
    "bottleneck_dilations": [
      2,
      4
    ],
    "edge_kernel": "scharr",
    "median_kernel": 3,
    "edge_lo": 0.1,
    "edge_hi": 0.35,
    "logvar_min": -10.0,
    "logvar_max": 10.0
  },
  "epochs": 1000,
  "batch_size": 8,
  "lr": 0.0003,
  "weight_decay": 1e-05,
  "min_lr": 1e-05,
  "val_split": 0.1,
  "seed": 42,
  "num_workers": 0,
  "patience": 40,
  "noise_std": 0.02,
  "augmentation": true,
  "translate": 0.01,
  "degrees": 1.0,
  "brightness": 0.1,
  "contrast": 0.1,
  "hflip": false,
  "vflip": false,
  "loss_kind": "mse",
  "l1_weight": 1.0,
  "use_ssim": true,
  "ssim_weight": 0.8,
  "grad_loss_w": 0.0,
  "edge_weighted_l1": false,
  "edge_l1_extra_w": 3.0,
  "beta_vae_target": 0.3,
  "beta_vae_warmup_epochs": 100,
  "kl_reduction": "sum_per_sample",
  "use_gan": false,
  "gan_start_epoch": 60,
  "gan_weight": 0.05,
  "gan_lr": 0.0001,
  "discriminator_base": 32,
  "grad_clip": 5.0,
  "image_percentile": 99.0,
  "pixel_percentile": 99.5,
  "calibration_pixels": 1000000
}
