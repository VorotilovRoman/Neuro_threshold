{
  "model": {
    "arch": "unet_v2",
    "model_type": "ae",
    "in_channels": 3,
    "img_h": 256,
    "img_w": 256,
    "preprocessing_version": "ae-pil-v1",
    "vae_use_mean": true,
    "keep_aspect": true,
    "pad_value": 0,
    "latent_channels": 24,
    "norm_type": "gn",
    "bottleneck_dilations": [
      2,
      4
    ],
    "use_edge_channel": true,
    "edge_kernel": "scharr",
    "median_kernel": 3,
    "edge_lo": 0.1,
    "edge_hi": 0.35,
    "model_in_channels": 4,
    "out_channels": 3,
    "base": 32,
    "logvar_min": -10.0,
    "logvar_max": 10.0
  },
  "epochs": 120,
  "batch_size": 16,
  "lr": 0.0003,
  "weight_decay": 1e-05,
  "min_lr": 1e-05,
  "val_split": 0.2,
  "seed": 42,
  "num_workers": 0,
  "patience": 25,
  "noise_std": 0.05,
  "augmentation": true,
  "translate": 0.03,
  "degrees": 2.0,
  "brightness": 0.15,
  "contrast": 0.15,
  "hflip": true,
  "vflip": false,
  "loss_kind": "l1",
  "l1_weight": 0.7,
  "use_ssim": true,
  "ssim_weight": 0.35,
  "grad_loss_w": 2.0,
  "edge_weighted_l1": true,
  "edge_l1_extra_w": 3.0,
  "beta_vae_target": 0.0,
  "beta_vae_warmup_epochs": 60,
  "kl_reduction": "mean",
  "use_gan": true,
  "gan_start_epoch": 60,
  "gan_weight": 0.05,
  "gan_lr": 0.0001,
  "discriminator_base": 32,
  "grad_clip": 5.0,
  "image_percentile": 99.0,
  "pixel_percentile": 99.5,
  "calibration_pixels": 1000000
}
